# Gmail SMTP credentials (used by the serverless functions to send enquiry emails)
# Do NOT commit real values. Copy this file to `.env` and fill in.

# The Gmail address that sends the email (your portfolio email)
GMAIL_USER=lokanshii@gmail.com

# A Gmail "App Password" — NOT your normal password.
# Generate one here: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your-16-char-app-password

# Where enquiries are delivered (defaults to GMAIL_USER if not set)
CONTACT_EMAIL=lokanshii@gmail.com
